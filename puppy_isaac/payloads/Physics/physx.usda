#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "puppy"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "puppy"
{
    over "Physics"
    {
        over "lb_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "lb_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rb_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rb_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rf_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rf_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "lf_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "lf_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

