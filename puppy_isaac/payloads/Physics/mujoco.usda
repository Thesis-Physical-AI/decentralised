#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "puppy"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "puppy"
{
    over "Physics"
    {
        over "lb_joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "lb_joint2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rb_joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rb_joint2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rf_joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rf_joint2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "lf_joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "lf_joint2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "lb_joint1_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/lb_joint1>
        }

        def MjcActuator "lb_joint2_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/lb_joint2>
        }

        def MjcActuator "rb_joint1_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/rb_joint1>
        }

        def MjcActuator "rb_joint2_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/rb_joint2>
        }

        def MjcActuator "rf_joint1_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/rf_joint1>
        }

        def MjcActuator "rf_joint2_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/rf_joint2>
        }

        def MjcActuator "lf_joint1_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/lf_joint1>
        }

        def MjcActuator "lf_joint2_actuator"
        {
            uniform double mjc:forceRange:max = 0.5
            uniform double mjc:forceRange:min = -0.5
            custom rel mjc:target
            append rel mjc:target = </puppy/Physics/lf_joint2>
        }
    }
}

